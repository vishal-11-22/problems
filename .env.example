# LeetCode Credentials
# Get these from: leetcode.com → DevTools (F12) → Application → Cookies
LEETCODE_SESSION=your_session_cookie_here
LEETCODE_CSRF_TOKEN=your_csrftoken_here

# GitHub (only needed for local push, not required for GitHub Actions)
GITHUB_TOKEN=your_github_pat_here
GITHUB_REPO=username/leetcode-solutions
